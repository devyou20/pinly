# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. NEVER prefix with NEXT_PUBLIC_. Used by scripts/seed.ts only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: set to "true" once Google OAuth is configured in Supabase Auth
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false

# Public site URL, used for OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
